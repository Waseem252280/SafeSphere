<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="primaryBackground" parent="Theme.Material3.DayNight.NoActionBar">

    </style>

<!--    texts-->
<!--    headings-->
    <style name="heading">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/_18ssp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!--    headings2-->
    <style name="heading2">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/_16ssp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!--    heading2-->
    <style name="heading3">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/_11ssp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/android:textColor</item>
    </style>


    <!--    text-->
    <style name="descriptionText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted_color</item>
        <item name="android:textSize">@dimen/_10ssp</item>
<!--        <item name="android:layout_marginLeft">4dp</item>-->
        <item name="android:fontFamily">sans-serif</item>
    </style>

<!--    small text-->
    <style name="smallText">
        <item name="android:textSize">@dimen/_8ssp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted_color</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!--    form-->
    <style name="FormCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardElevation">@dimen/_1sdp</item>
        <item name="cardCornerRadius">@dimen/_50sdp</item>
        <item name="cardBackgroundColor">?attr/colorOnPrimary</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="FormField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/android:textColor</item>
        <item name="android:backgroundTint">?attr/colorOnPrimary</item>
        <item name="drawableTint">?attr/colorPrimary</item>
    </style>

    <!-- cards -->
    <style name="cardView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">?attr/colorOnPrimary</item>
        <item name="contentPadding">@dimen/_14sdp</item>
        <item name="cardCornerRadius">@dimen/_16sdp</item>
        <item name="android:layout_marginTop">@dimen/_1sdp</item>
        <item name="android:layout_marginBottom">@dimen/_6sdp</item>
    </style>

    <style name="header_footer_card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">?attr/colorOnPrimary</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorPrimaryVariant</item>
    </style>

<!--    buttons-->
    <style name="IconButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">@dimen/_36sdp</item>
        <item name="android:layout_height">@dimen/_36sdp</item>
        <item name="android:background">@drawable/icon_button_background</item>
        <item name="android:padding">@dimen/_8sdp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="activeButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">@dimen/_36sdp</item>
        <item name="android:layout_height">@dimen/_36sdp</item>
        <item name="android:background">@drawable/active_button_background</item>
        <item name="android:padding">@dimen/_8sdp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="cardIconButton" >
        <item name="android:layout_width">@dimen/_36sdp</item>
        <item name="android:layout_height">@dimen/_36sdp</item>
        <item name="android:background">@drawable/card_icon_button</item>
        <item name="android:padding">@dimen/_8sdp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:outlineProvider">none</item>
    </style>


    <style name="CircleIconButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginTop">@dimen/_18sdp</item>
        <item name="android:background">@drawable/circle_button_background</item>
        <item name="android:padding">@dimen/_24sdp</item>
    </style>

    <style name="primaryButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_40sdp</item>
        <item name="android:layout_marginTop">@dimen/_6sdp</item>
        <item name="android:background">@drawable/primary_button_background</item>
        <item name="android:paddingStart">@dimen/_18sdp</item>
        <item name="android:paddingEnd">@dimen/_18sdp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="DividerLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">@dimen/_12sdp</item>
        <item name="android:background">?attr/colorPrimaryVariant</item>
    </style>

<!--    notification badge-->
    <style name="NotificationBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">@dimen/_9ssp</item>
        <item name="android:background">@drawable/badge_background</item>
        <item name="android:elevation">@dimen/_4sdp</item>
        <item name="android:paddingHorizontal">@dimen/_4sdp</item>
        <item name="android:paddingBottom">@dimen/_1sdp</item>
        <item name="android:layout_marginTop">@dimen/_2sdp</item>
        <item name="android:layout_marginStart">@dimen/_22sdp</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>

<!--    roundedImageView-->
    <style name="RoundedImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:clipToOutline">true</item>
        <item name="cornerSize">50%</item> <!-- makes it circular -->
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>


<!--    bottom nav background-->
    <style name="BottomNavIndicatorStyle">
        <item name="android:color">?attr/colorPrimaryVariant</item>
        <item name="android:shape">rectangle</item>
        <item name="android:radius">16dp</item>
        <item name="android:width">40dp</item>
        <item name="android:height">40dp</item>
    </style>


    <style name="MyCustomTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/_9ssp</item> <item name="android:textAllCaps">false</item> <item name="android:textColor">@color/muted_color</item>
    </style>

    <style name="TabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/_8ssp</item> <item name="android:textAllCaps">false</item> <item name="textAllCaps">false</item> <item name="android:textStyle">normal</item>
    </style>

    <style name="CustomPopupMenuStyle" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">?attr/colorOnPrimary</item>

        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>