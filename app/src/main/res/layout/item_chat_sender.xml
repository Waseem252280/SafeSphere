<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="1dp"
    android:gravity="end">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_sender"
        android:padding="8dp"
        android:layout_marginStart="@dimen/_50sdp">
        <FrameLayout
            android:id="@+id/profileFrame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profile_image"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:src="@drawable/profile"
                android:layout_gravity="center_vertical"/>
            <ImageView
                android:id="@+id/ivMic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_mic"
                android:layout_marginStart="32dp"
                android:tint="#ABA2A2A2"
                android:layout_marginTop="24dp"
                android:layout_gravity="bottom"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center_vertical">

            <FrameLayout
                android:id="@+id/imageContainer"
                android:layout_width="180dp"
                android:layout_height="220dp"
                android:visibility="gone"
                android:background="@drawable/bg_media_rounded"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/imgMessage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"
                    android:contentDescription="Image message"/>

                <!-- 🔥 Bottom-left IMAGE icon -->
                <ImageView
                    android:id="@+id/ivImageIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="6dp"
                    android:src="@drawable/ic_image"
                    android:tint="@android:color/white"/>
            </FrameLayout>


            <FrameLayout
                android:id="@+id/videoContainer"
                android:layout_width="200dp"
                android:layout_height="220dp"
                android:visibility="gone"
                android:background="@drawable/bg_media_rounded"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:clickable="true"
                android:focusable="true">
            <ImageView
                android:id="@+id/videoThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:contentDescription="Video thumbnail"/>
                <ImageView
                    android:id="@+id/btnPlayVideo"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_play_circle"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Play video"/>

                <ImageView
                    android:id="@+id/ivVideoIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="6dp"
                    android:src="@drawable/ic_video"
                    android:tint="@android:color/white"/>
                <TextView
                    android:id="@+id/videoDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|start"
                    android:padding="4dp"
                    android:text="0:00"
                    android:layout_marginStart="30dp"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"/>

            </FrameLayout>
            <LinearLayout
                android:id="@+id/docContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone"
                android:background="@drawable/bg_doc"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/docIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_doc"
                    android:contentDescription="Document icon"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/docName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="document.pdf"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/docSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.2 MB"
                        android:textColor="@color/lightGray"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/contactContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone"
                android:background="@drawable/bg_doc"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_person"
                    android:tint="@color/white"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/contactName"
                        android:text="Ali Khan"
                        android:textSize="14sp"
                        android:textColor="@color/white"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/contactPhone"
                        android:text="03011234567"
                        android:textSize="12sp"
                        android:textColor="@color/lightGray"/>
                </LinearLayout>
            </LinearLayout>



            <LinearLayout
                android:layout_width="wrap_content"
                android:minWidth="@dimen/_50sdp"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/donwloadingFrame"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_cancel"
                        android:tint="@color/lightGray"
                        android:layout_marginStart="4dp"
                        android:layout_gravity="center_vertical"/>
                    <ProgressBar
                        android:id="@+id/audioLoading"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:visibility="visible"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/green" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/restartDownloading"
                    android:layout_width="36dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_retry_download"
                    android:tint="@color/lightGray"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"/>


                <ImageView
                    android:id="@+id/btnPlayAudio"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_play"
                    android:layout_marginEnd="8dp"/>

                <ImageView
                    android:id="@+id/audioWave"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_audio_wave"/>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:id="@+id/deletedIcon"
                    android:src="@drawable/ic_removed"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/tvMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:minWidth="@dimen/_50sdp">

                <TextView
                    android:id="@+id/audioDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textSize="12sp"
                    android:layout_marginStart="10dp"
                    android:layout_gravity="center_vertical"
                    android:textColor="@color/lightGray"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvTime"
                    android:text="12:30"
                    android:textSize="10sp"
                    android:textColor="#DADADA"/>

                <ImageView
                    android:id="@+id/imgStatus"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="Message status"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
