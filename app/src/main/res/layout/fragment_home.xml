<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    tools:context=".fragments.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            style="@style/header_footer_card"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/_16sdp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        style="@style/heading"
                        android:textColor="?attr/android:textColor"
                        android:text="Family Circle" />
                    <TextView
                        android:id="@+id/familyMemberCount"
                        android:text="0 Members connected"
                        style="@style/descriptionText"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:textColor="@color/green" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end">
                    <androidx.appcompat.widget.AppCompatButton
                        style="@style/cardIconButton"
                        android:background="@drawable/card_icon_button_bg"
                        android:id="@+id/familyCircleNotifications"
                        android:drawableStart="@drawable/ic_notification"
                        android:drawableTint="?attr/android:textColor"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:elevation="0dp" />

                    <androidx.appcompat.widget.AppCompatButton
                        style="@style/cardIconButton"
                        android:background="@drawable/card_icon_button_bg"
                        android:id="@+id/btnSettings"
                        android:drawableStart="@drawable/ic_settings"
                        android:drawableTint="?attr/android:textColor"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:elevation="0dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_20sdp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/layoutSOS"
                    android:visibility="gone">
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSOS"
                        style="@style/IconButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/red"
                        android:drawableStart="@drawable/ic_emergency"
                        android:text=" Emergency"
                        android:textSize="@dimen/_11ssp"
                        android:backgroundTint="?attr/colorOnPrimary"
                        android:drawableEnd="@drawable/ic_arrow_right_siren" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardEmergencySection"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/android:colorBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    app:cardCornerRadius="16dp"
                    android:focusable="true"
                    app:contentPadding="10dp"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="74dp"
                        android:padding="@dimen/_6sdp">

                        <LinearLayout
                            android:id="@+id/layoutAddContact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="visible">

                            <FrameLayout
                                android:layout_width="@dimen/_40sdp"
                                android:layout_height="@dimen/_40sdp"
                                android:background="@drawable/dashed_border_circle"
                                android:padding="@dimen/_12sdp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/ic_group"
                                    app:tint="?attr/colorPrimary" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_12sdp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Safety Action Required"
                                    android:textColor="?attr/android:textColor"
                                    android:textSize="@dimen/_11ssp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Add your trusted contact numbers to rescue you in emergency"
                                    android:textColor="@color/muted_color"
                                    android:textSize="@dimen/_10ssp" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:layout_marginTop="@dimen/_12sdp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/_6sdp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                style="@style/heading2"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="Family Status"
                                android:textColor="?attr/android:textColor" />
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/familyMembersViewMap"
                                style="@style/IconButton"
                                android:layout_width="wrap_content"
                                android:drawableStart="@drawable/ic_location"
                                android:drawableTint="?attr/colorPrimary"
                                android:text="View Map"
                                android:drawableEnd="@drawable/ic_arrow_right_smooth" />
                        </LinearLayout>

                        <com.google.android.material.tabs.TabLayout
                            android:id="@+id/statusTabLayout"
                            app:tabBackground="?attr/android:colorBackground"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp"
                            app:tabMode="fixed"
                            app:tabGravity="fill"
                            app:tabMaxWidth="0dp"
                            app:tabIndicatorHeight="2.5dp"
                            app:tabIndicatorColor="?attr/colorPrimary"
                            app:tabSelectedTextColor="?attr/colorPrimary"
                            app:tabTextColor="@color/muted_color"
                            app:tabIconTint="@null"
                            app:tabTextAppearance="@style/TabTextStyle"
                            app:tabInlineLabel="false">

                            <com.google.android.material.tabs.TabItem
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="All (0)"
                                android:icon="@drawable/ic_group" />

                            <com.google.android.material.tabs.TabItem
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Online (0)"
                                android:iconTint="@color/green"
                                android:icon="@drawable/ic_status_dot" />

                            <com.google.android.material.tabs.TabItem
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Away (0)"
                                android:iconTint="#FFA500"
                                android:icon="@drawable/ic_location" />

                            <com.google.android.material.tabs.TabItem
                                android:id="@+id/tabSafe"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Safe (0)"
                                android:icon="@drawable/ic_safe" />
                        </com.google.android.material.tabs.TabLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>


                <LinearLayout
                    android:id="@+id/emptyMembersLayout"
                    android:layout_marginTop="@dimen/_25sdp"
                    android:layout_width="@dimen/_200sdp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:paddingBottom="@dimen/_10sdp"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="@dimen/_50sdp"
                        android:layout_height="@dimen/_50sdp"
                        android:src="@drawable/ic_family"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:layout_gravity="center"
                        android:tint="?attr/colorPrimary"/>

                    <TextView
                        android:id="@+id/tvError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="You have not any family member yet click button bellow to add."
                        android:textColor="@color/muted_color"
                        android:visibility="visible"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/_5sdp" />

                </LinearLayout>


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/familyMembersRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_family_members" />


            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addFamilyMemberFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/_20sdp"
        android:contentDescription="Add Family Member"
        android:src="@drawable/ic_family"
        app:tint="@color/white"
        app:backgroundTint="?attr/colorPrimary"
        app:maxImageSize="@dimen/_24sdp"
        android:elevation="@dimen/_4sdp" />
</FrameLayout>