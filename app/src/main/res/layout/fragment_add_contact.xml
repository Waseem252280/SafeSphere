<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_30sdp"
    app:cardCornerRadius="@dimen/_16sdp"
    app:cardElevation="@dimen/_8sdp"
    app:strokeColor="#1A888888"
    app:cardBackgroundColor="?attr/colorOnPrimary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_20sdp">

        <ImageView
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:layout_gravity="center"
            android:src="@drawable/ic_safe"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Trusted Contact"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="@dimen/_16sdp"
            android:textColor="?attr/android:textColor" />

        <TextView

            android:layout_marginTop="@dimen/_16sdp"
            android:textColor="?attr/android:textColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This person will receive an SOS alert when you are in danger."
            android:textSize="@dimen/_10ssp"
            android:gravity="center"
            android:layout_marginBottom="@dimen/_20sdp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint=" Contact Name"
            android:textColor="?attr/android:textColor"
            android:textColorHint="?attr/android:textColor">

            <com.google.android.material.textfield.TextInputEditText
                android:drawableStart="@drawable/ic_person"
                android:drawableTint="?attr/android:textColor"
                android:id="@+id/etContactName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textColor="?attr/android:textColor"
                android:textColorHint="?attr/android:textColor"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint=" Phone Number"
            android:layout_marginTop="@dimen/_10sdp"
            android:textColor="?attr/android:textColor"
            android:textColorHint="?attr/android:textColor">

            <com.google.android.material.textfield.TextInputEditText
                android:textColor="?attr/android:textColor"
                android:textColorHint="?attr/android:textColor"
                android:drawableStart="@drawable/ic_phone"
                android:drawableTint="?attr/android:textColor"
                android:id="@+id/etContactPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveContact"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_45sdp"
                android:text="Save Trusted Contact"
                android:textSize="12.5sp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="@dimen/_8sdp"
                app:icon="@drawable/ic_sent"
                app:iconGravity="end"
                app:iconTint="@color/white" />

            <ProgressBar
                android:id="@+id/progressLoading"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/_12sdp"
                android:visibility="gone"
                android:indeterminateTint="@color/white" />
        </FrameLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>