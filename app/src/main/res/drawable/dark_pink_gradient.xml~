<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Gradient colors -->
    <gradient
        android:startColor="#BA0942"
        android:endColor="#CA027A"
        android:angle="45" />

    <!-- Corner radius -->
    <corners android:radius="12dp" />

    <!-- Optional border -->
    <stroke
        android:width="2dp"
        android:color="#FFFFFF" />

</shape>
